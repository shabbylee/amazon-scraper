# 服务端口
PORT=3456

# Chrome 可执行文件路径（自动寻找可留空）
# macOS 常见路径：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PATH=

# 是否使用 headless 模式（true=无头，false=可见浏览器窗口）
HEADLESS=true

# 默认 Marketplace（Phase 1 只支持 com；Phase 2 会扩展 cojp / de / cn / couk）
DEFAULT_MARKETPLACE=com

# 相邻 Attempt 最小间隔（毫秒）。硬下限 2000（AGENTS.md 抓取伦理），配低了会被夹回 2000
REQUEST_INTERVAL_MS=2000

# 并发 Attempt 上限。硬上限 2（AGENTS.md 抓取伦理），配高了会被夹回 2
MAX_CONCURRENT_ATTEMPTS=1

# 代理池：逗号分隔的代理 URL 列表（支持 http / https / socks4 / socks5，可带 basic auth）
# 留空 = 不用代理，Scraper 走本机直连
# 连续失败 3 次的端点会进入 30 秒冷却；成功归还重置计数
# 示例：HTTP_PROXY_LIST=http://user:pass@proxy1.example.com:3128,http://proxy2.example.com:8080
# HTTP_PROXY_LIST=
